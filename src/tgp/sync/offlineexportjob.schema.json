{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tgp.ro/schemas/offline-export-job-v1.json",
  "title": "TGP-FIELD Offline Export Job",
  "type": "object",
  "required": ["schemaVersion", "jobId", "projectId", "archivePath", "remotePath", "sha256", "state"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "archivePath": { "type": "string" },
    "remotePath": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "attempts": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["preparing", "waiting_for_network", "uploading", "verifying", "complete", "failed"] },
    "lastError": { "type": ["string", "null"] },
    "keepLocalCopy": { "type": "boolean", "default": true }
  }
}
